# ⭐ DISTRIBUIDOR (6/10/2026): esta carpeta tiene sus propias reglas, así que
#    no hereda las de la raíz. Repite el reenvío a invitameok.net (ver /.htaccess).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^invitame\.littlemomentsok\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^ https://invitameok.net%{REQUEST_URI} [R=301,L]
</IfModule>

# La portada la sirve index.php (arma la vista previa por evento para WhatsApp)
DirectoryIndex index.php index.html

# Evitar que el HTML se cachee (para que las invitaciones actualizadas salgan siempre bien)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
# LiteSpeed: no cachear los .html de esta carpeta
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .*\.html$ - [E=Cache-Control:no-cache]
</IfModule>

# ===== LAS TEXTURAS DE PAPEL VIVEN EN CLOUDINARY =============================
# El problema: index.html pide las texturas por nombre relativo
# (`--sec-tex: url('tex-lino.jpg')`, linea 1284), o sea /i/tex-lino.jpg. Pero
# en esta carpeta NO hay ni una imagen, y nunca la hubo: los binarios no entran
# al repo por el camino con el que se sube el codigo. Resultado medido el
# 4/9/2026: las cinco texturas daban 404, el selector de textura del panel de
# Jazmin ofrecia cinco opciones y ninguna existia, y TODA invitacion se veia en
# color plano en vez de papel. Eran 29 pedidos fallidos por carga.
#
# La solucion sin tocar index.html (185 KB, no se puede reescribir entero):
# que esas direcciones RESUELVAN. Las texturas se dibujaron con canvas
# (fibra, trama, vetas y diente, casi blancas porque se multiplican sobre el
# color de cada seccion) y se subieron a nuestro Cloudinary.
#
# /!\ La condicion !-f es lo que deja la puerta abierta: el dia que alguien
#     suba de verdad /i/tex-lino.jpg, ese archivo GANA y esto ni se ejecuta.
# /!\ Va 302 y no 301 a proposito. Un 301 se le queda pegado al navegador para
#     siempre y ya no volveria a preguntarle al servidor: si mañana se cambia
#     una textura, media Mexico seguiria viendo la vieja.
<IfModule mod_rewrite.c>
  # ⭐ 9/10/2026: las nueve direcciones de abajo ya NO van a Cloudinary acá.
  #    Las atiende i/textura.php (por dentro, sin un salto más), que las manda
  #    por el cache si está atendiendo y a Cloudinary directo si no — la misma
  #    decisión que toma la invitación. Las direcciones de Cloudinary, con su
  #    receta f_auto,q_auto:good,w_1200,c_limit, viven ahora en ese archivo.
  #    (Por qué existen estos desvíos: ver la historia de arriba y la del 14/9
  #    en el historial de este archivo.)
  # /!\ La condición !-f sigue: si alguien sube de verdad /i/tex-lino.jpg, ese
  #     archivo GANA y esto ni se ejecuta.
  RewriteEngine On
  RewriteBase /i/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(tex-(papel|lino|kraft|marmol|acuarela)\.jpg|textura\.jpg|nube\.png|cielo\.jpg|sello-marfil\.png)$ textura.php?n=$1 [L]
</IfModule>
