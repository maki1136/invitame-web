# ⭐ DISTRIBUIDOR (6/10/2026): esta carpeta tiene sus propias reglas, así que
#    no hereda las de la raíz. Repite el reenvío a invitameok.net (ver /.htaccess).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^invitame\.littlemomentsok\.com$ [NC]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^ https://invitameok.net%{REQUEST_URI} [R=301,L]
</IfModule>

# La portada la sirve index.php (arma la vista previa por evento para WhatsApp)
DirectoryIndex index.php index.html

# Evitar que el HTML se cachee (para que las invitaciones actualizadas salgan siempre bien)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
# LiteSpeed: no cachear los .html de esta carpeta
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .*\.html$ - [E=Cache-Control:no-cache]
</IfModule>
