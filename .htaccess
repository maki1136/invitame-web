# No cachear los HTML (para que el formulario/catálogo/admin salgan siempre actualizados)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Los .js y .css TAMBIEN tienen que revalidar. Sin esto el navegador se los guarda
  # 7 dias: si arreglamos un bug del motor o volvemos atras, el invitado que ya entro
  # sigue viendo la version rota hasta una semana. Con "no-cache" el navegador igual
  # los guarda, pero pregunta si cambiaron (responde 304, no vuelve a bajar el archivo).
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule Litespeed>
  RewriteEngine On
  RewriteRule .*\.html$ - [E=Cache-Control:no-cache]
  RewriteRule .*\.(js|css)$ - [E=Cache-Control:no-cache]
</IfModule>

# --- Seguridad ---
# Referrer-Policy es la clave: evita que el link de la invitación (con el token del
# invitado) se filtre a sitios de afuera cuando el invitado toca un mapa o mesa de regalos.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Bloquear archivos ocultos (.git, .env, etc.) por si alguna vez llegan al servidor
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
